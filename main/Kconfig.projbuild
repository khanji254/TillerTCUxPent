# put here your custom config value
menu "Example Configuration"
config ESP_WIFI_SSID
    string "WiFi SSID"
    default "myssid"
    help
	SSID (network name) for the example to connect to.

config ESP_WIFI_PASSWORD
    string "WiFi Password"
    default "mypassword"
    help
	WiFi password (WPA or WPA2) for the example to use.
endmenu

menu "ThingsBoard Configuration"
    config TB_PROVISION_KEY
        string "ThingsBoard Provisioning Key"
        default ""
        help
            Device profile provisioning key. Leave empty if pre-flashing via NVS.

    config TB_PROVISION_SECRET
        string "ThingsBoard Provisioning Secret"
        default ""
        help
            Device profile provisioning secret.
endmenu
